# Foundation works without secrets. Existing local .env is preserved.
GEMINI_API_KEY=
# Optional Gemini overrides. The timeout stays under the browser's 10 s abort.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=8000
# Whole-scene interpretation is slower than a single edit.
# GEMINI_SCENE_TIMEOUT_MS=20000
# Jev (TypeSafe) decides what happens when a new drawing enters the world.
# Server-only. Without it drawings are still added, just without an outcome.
JEV_STORYWORLD_KEY=
# Optional Jev overrides.
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=4000
ELEVENLABS_API_KEY=
HOST=0.0.0.0
PORT=3001
# Use fixture for onboarding; live requires a deployed matching module.
VITE_WORLD_MODE=fixture
VITE_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DATABASE=storyworld-zhvbk
